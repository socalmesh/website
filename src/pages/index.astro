---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import MapLinks from '../components/MapLinks.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import ChannelCards from '../components/ChannelCards.astro';
import StartHere from '../components/StartHere.astro';
import DiscordCTA from '../components/DiscordCTA.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
import { url } from '../lib/url';
import { publishedArticles } from '../lib/help';
import { Image } from 'astro:assets';
// The SDR waterfall lives outside src/assets/photos/ so the grid does not pick it up.
import sdrWaterfall from '../assets/sdr-waterfall.jpg';
// A QR code of site.secondaryChannels.addUrl. See the note beside that link in site.ts.
import secondaryChannelsQr from '../assets/secondary-channels-qr.svg';

const [firstSecondary, secondSecondary] = site.secondaryChannels.names;

const latest = (await publishedArticles()).slice(0, 3);

---

<BaseLayout title={site.name} description={site.tagline}>
  <Hero />

  <Section
    id="about"
    eyebrow="About"
    title="About SoCal Mesh"
    lede="We use radios to send messages without cell service or internet access."
  >
    <div class="blocks">
      <article>
        <h3>What is SoCal Mesh?</h3>
        <p>
          SoCal Mesh is a community of individuals working to build a network of Meshtastic
          radios in Southern California. This network acts like an area-wide text messaging
          system, allowing people to communicate publicly or privately with anyone on the
          network. The mesh network can also be used to transmit GPS locations or read weather
          and other telemetry. All of this happens without any external infrastructure. No
          cell phone towers, no internet. We have hundreds of nodes and are growing every day.
          Please join us and feel free to ask questions on our{' '}
          <a href={url(site.discord.path)}>Discord</a>.
        </p>
      </article>

      <article>
        <h3>What is Meshtastic?</h3>
        <p>
          Meshtastic is an open source, decentralized, off-grid mesh network. It runs on small,
          inexpensive LoRa radios that can relay messages over long distances. You can connect
          your phone to one over Bluetooth or Wi-Fi. Learn more at the{' '}
          <a href={site.meshtastic.site} rel="noopener">official Meshtastic website</a>.
        </p>
      </article>

      <article>
        <h3>How it works</h3>
        <p>
          People across Southern California run nodes. Some are at home, some sit on hilltops, some
          live in a backpack. The radios talk to each other over LoRa in the 915 MHz band used in
          the US. The exact frequency comes from the preset and frequency slot you set, which is why
          it matters that we all use the same ones. They mesh using the open source Meshtastic
          firmware. You pair your own node to your phone over Bluetooth or Wi-Fi, and the node
          handles the radio side. Messages hop from node to node, so the network reaches further
          than any single radio can, and it keeps working when one node drops off.
        </p>
      </article>
    </div>
  </Section>

  <Section
    id="channels"
    tone="raised"
    eyebrow="Channels"
    title="The channels we run"
  >
    <Fragment slot="lede">
      Start on LongTurbo, frequency slot 14. We recommend firmware{' '}
      <a href={site.firmware.recommended} rel="noopener">2.7.26 Beta</a>. LongTurbo is the default
      in <a href={site.firmware.defaultSince} rel="noopener">2.8</a>, but we're seeing problems
      with the 2.8 alphas.
    </Fragment>

    <ChannelCards />

    <div class="why">
      <div>
        <h3>Why LongTurbo?</h3>
        <p>
          LongFast and MediumFast don't comply with{' '}
          <a href={site.fccRule} rel="noopener">FCC rule 15.247</a>, which requires a channel at
          least 500 kHz wide, and we don't condone using them. LongTurbo is 500 kHz wide. It also
          got rid of the problems that plagued bigger meshes on the Fast presets.
        </p>
      </div>
      <div>
        <h3>Why not stay on LongFast?</h3>
        <p>
          It's the old default, so it's where the unattended ghost nodes sit. They run old
          firmware and don't make for a reliable mesh.
        </p>
      </div>
      <div>
        <h3>How to tell what's near you</h3>
        <p>
          Check <a href={site.maps[0].url} rel="noopener">our live map</a> for LongTurbo slot 14
          nodes. A node only shows up if its owner switched on OK to MQTT, so there are always
          more on the air than the map shows.
        </p>
      </div>
    </div>

    <div class="secondary">
      <div class="secondary-text">
        <h3>Private channels: {firstSecondary} and {secondSecondary}</h3>
        <p>
          Our two private secondary channels. They use the same frequency and preset, so nothing
          else on your radio changes. Open the link on the phone paired to your radio, or scan
          the code, and choose <strong>add</strong>, not replace.
        </p>
        <p class="secondary-action">
          <Button href={site.secondaryChannels.addUrl} variant="ghost" external>
            Add both channels
          </Button>
        </p>
      </div>
      <img
        class="qr"
        src={secondaryChannelsQr.src}
        width="200"
        height="200"
        alt={`QR code that adds the ${firstSecondary} and ${secondSecondary} channels in the Meshtastic app`}
        loading="lazy"
        decoding="async"
      />
    </div>
  </Section>

  <Section
    id="start"
    eyebrow="New here?"
    title="Start here"
    lede="From an unopened radio to your first message on the mesh."
  >
    <StartHere />
    <p class="more">
      <Button href={url(site.discord.path)} variant="accent">Ask us on Discord</Button>
    </p>
  </Section>

  <Section
    id="maps"
    tone="raised"
    eyebrow="Maps"
    title="See the network"
    lede="Four views of the mesh. None of them shows all of it."
  >
    <MapLinks />

    <p class="warn">
      A node only reaches these maps if its owner switched on <strong>OK to MQTT</strong>, which is
      permission rather than an upload: it lets any gateway that hears you pass your traffic on.
      Plenty of people never turn it on, so there are always more nodes on the air than the maps
      show. Empty ground means nobody there is uplinking, not that nobody is there.{' '}
      <a href={url('/help/how-do-i-uplink-to-mqtt/')}>How to turn it on</a>.
    </p>
  </Section>

  <Section
    id="help"
    eyebrow="Help"
    title="Getting started"
    lede="Short guides written by people in the mesh."
  >
    {
      latest.length > 0 ? (
        <>
          <div class="cards">
            {latest.map((article) => (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                author={article.data.author}
                date={article.data.date}
                updated={article.data.updated}
              />
            ))}
          </div>
          <p class="more">
            <a href={url('/help/')}>All help articles →</a>
          </p>
        </>
      ) : (
        <p class="lede">
          No articles yet. Ask on <a href={url(site.discord.path)}>Discord</a> and we'll
          write one.
        </p>
      )
    }
  </Section>

  <Section
    id="photos"
    tone="raised"
    eyebrow="Photos"
    title="Out in the field"
    lede="Nodes, antennas, meetups, and a waterfall full of LoRa."
  >
    <PhotoGrid />
    <div class="sdr">
      <Image
        src={sdrWaterfall}
        alt="An SDR waterfall display showing bursts of LoRa traffic near 906.9 MHz"
        widths={[480, 800, 1200, 1600]}
        width={1600}
        height={900}
        sizes="(min-width: 64rem) 60rem, 92vw"
        format="webp"
        quality={72}
        loading="lazy"
        decoding="async"
      />
      <p class="caption">LoRa traffic on the 33 cm band, seen from an SDR.</p>
    </div>
  </Section>

  <Section id="discord">
    <DiscordCTA />
  </Section>

  <Section
    id="community"
    tone="raised"
    eyebrow="Community"
    title="Projects and links"
    lede="Everything we run is open source."
  >
    <ul class="links">
      {
        site.communityLinks.map((link) => (
          <li>
            <a href={link.url} rel="noopener">
              {link.name}
            </a>
            <p>{link.blurb}</p>
          </li>
        ))
      }
    </ul>

    <p class="sources">
      We also lean on a handful of open source projects that aren't ours, including the software
      behind our map and the parrot in our Discord. They are listed and thanked on the{' '}
      <a href={url('/links/')}>links page</a>.
    </p>

    <p class="more">
      <Button href={url(site.discord.path)} variant="accent">Join us on Discord</Button>
    </p>
  </Section>
</BaseLayout>

<style>
  .blocks {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .blocks h3 {
    margin-bottom: var(--space-xs);
  }

  .blocks p {
    color: var(--text-muted);
  }

  .cards {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .more {
    margin-top: var(--space-m);
  }

  .sdr {
    margin-top: var(--space-m);
  }

  .sdr img {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  /* --text-muted, not --text-faint: this caption sits on the raised background,
     where the fainter grey does not have enough contrast to read comfortably. */
  .caption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m);
    margin-bottom: var(--space-m);
  }

  .why h3 {
    margin: 0 0 0.35rem;
    font-size: var(--step-0);
  }

  .why p {
    margin: 0;
    color: var(--text-muted);
  }

  .sources {
    max-width: 70ch;
    margin: 0 0 var(--space-m);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .warn {
    max-width: 70ch;
    margin: var(--space-m) 0 0;
    padding: var(--space-s) var(--space-m);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--bg);
    color: var(--text-muted);
  }

  .warn strong {
    color: var(--text);
  }

  /* The secondary channels: text on the left, the QR code on the right, and the
     code drops underneath on a phone. */
  .secondary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .secondary-text {
    flex: 1 1 20rem;
    max-width: 70ch;
  }

  .secondary h3 {
    margin: 0 0 var(--space-xs);
    font-size: var(--step-0);
  }

  .secondary p {
    margin: 0 0 var(--space-s);
    color: var(--text-muted);
  }

  .secondary strong {
    color: var(--text);
  }

  .secondary .secondary-action {
    margin: var(--space-m) 0 0;
  }

  /* A QR code only scans if it stays dark on white with a clear edge around it, so
     this one keeps its own white square whatever the page colours are. */
  .qr {
    flex: none;
    width: 200px;
    height: 200px;
    border-radius: var(--radius-sm);
    background: #fff;
  }

  .links {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .links li {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-m);
  }

  .links a {
    font-weight: 650;
  }

  .links p {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
