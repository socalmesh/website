---
/**
 * The links page. Two kinds of thing live here:
 *   - other mesh communities, grouped by the technology each one runs (`meshLinks`);
 *   - the open source projects this network depends on (`projects`), with the credit.
 *
 * To add either, put it in `src/config/site.ts` under the right heading. Nothing
 * here needs editing.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

const title = 'Links';
const description =
  'Other mesh communities around the country, and the open source projects this network runs on.';
---

<BaseLayout title={title} description={description}>
  <Section eyebrow="Links" title={title} titleAs="h1" lede={description}>
    <h2>Other mesh communities</h2>
    <p class="group-note">
      Every one of these is run by people like us. Regional settings differ, so check theirs before
      you travel, and do not copy another region's frequency onto a radio you use here.
    </p>

    <h3>Meshtastic</h3>
    <p class="group-note">Same radios and firmware as us. Different part of the map.</p>
    <ul class="links">
      {
        site.meshLinks.meshtastic.map((link) => (
          <li>
            <a href={link.url} rel="noopener">
              {link.name}
            </a>
            <p>{link.blurb}</p>
          </li>
        ))
      }
    </ul>

    <h3>MeshCore</h3>
    <p class="group-note">
      MeshCore is a different mesh project with its own firmware. A MeshCore radio and a Meshtastic
      radio cannot interoperate, since neither one can decode or relay the other's traffic. That
      makes these neighbors rather than the same network. Worth reading, not worth flashing onto
      your node by mistake. A few of us do play around with MeshCore on its default settings, but
      the great majority of this group is on Meshtastic.
    </p>
    <ul class="links">
      {
        site.meshLinks.meshcore.map((link) => (
          <li>
            <a href={link.url} rel="noopener">
              {link.name}
            </a>
            <p>{link.blurb}</p>
          </li>
        ))
      }
    </ul>

    <h2>Projects we rely on</h2>
    <p class="group-note">
      None of these are ours. Our map, the parrot in our Discord and the tool a lot of us use to
      work out what is reaching what are all somebody else's open source work, and this network
      would be a poorer thing without them. Thank you to everyone who builds and maintains them.
    </p>
    <ul class="links">
      {
        site.projects.map((project) => (
          <li>
            <a href={project.url} rel="noopener">
              {project.name}
            </a>
            <p>{project.blurb}</p>
          </li>
        ))
      }
    </ul>

    <p class="back">
      <a href={url('/')}>&larr; Back to the home page</a>
    </p>
  </Section>
</BaseLayout>

<style>
  h2 {
    margin-top: var(--space-xl);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }

  h3 {
    margin-top: var(--space-l);
    font-size: var(--step-1);
  }

  .group-note {
    max-width: 62ch;
    margin-top: 0.35rem;
    color: var(--text-muted);
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-m);
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
  }

  .links li {
    margin: 0;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .links a {
    font-weight: 600;
  }

  .links p {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .back {
    margin-top: var(--space-l);
  }
</style>
