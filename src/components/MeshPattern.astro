---
/**
 * Decorative "nodes and links" backdrop — echoes the mesh diagram inside the logo.
 * Purely visual: aria-hidden, no text, no client-side JavaScript.
 */
---

<svg class="mesh-pattern" aria-hidden="true" focusable="false" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMid slice">
  <g class="links">
    <path d="M60 330 L210 210 L400 280 L560 150 L740 240 L900 130 L1140 200" />
    <path d="M210 210 L260 90 L560 150" />
    <path d="M400 280 L470 380 L740 240" />
    <path d="M900 130 L980 300 L1140 200" />
    <path d="M60 330 L470 380" />
    <path d="M260 90 L740 240" />
  </g>
  <g class="nodes">
    <circle cx="60" cy="330" r="5" />
    <circle cx="210" cy="210" r="7" />
    <circle cx="260" cy="90" r="4" />
    <circle cx="400" cy="280" r="5" />
    <circle cx="470" cy="380" r="4" />
    <circle cx="560" cy="150" r="8" />
    <circle cx="740" cy="240" r="6" />
    <circle cx="900" cy="130" r="5" />
    <circle cx="980" cy="300" r="4" />
    <circle cx="1140" cy="200" r="6" />
  </g>
</svg>

<style>
  .mesh-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    pointer-events: none;
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 20%, transparent 78%);
  }

  .links {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.25;
    opacity: 0.28;
  }

  .nodes {
    fill: var(--accent);
    opacity: 0.5;
  }
</style>
