---
import { Image } from 'astro:assets';
import logo from '../assets/socalmesh-logo.png';
import { site } from '../config/site';
import { url } from '../lib/url';

/* The header links. To add one: copy a line. `/#name` jumps to a section of the
   home page; `/name/` is a page of its own. */
const nav = [
  { label: 'Channels', href: url('/#channels') },
  { label: 'Maps', href: url('/#maps') },
  { label: 'Help', href: url('/help/') },
  { label: 'Links', href: url('/links/') },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      <Image
        class="logo-disc"
        src={logo}
        widths={[40, 80]}
        sizes="40px"
        format="webp"
        alt=""
        decoding="async"
      />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li>
          {/* The GitHub mark, drawn inline so nothing is loaded from another site. It has
              no visible text, so the aria-label is what a screen reader announces. */}
          <a class="icon-link" href={site.github.org} rel="noopener" aria-label="SoCal Mesh on GitHub">
            <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              />
            </svg>
          </a>
        </li>
        <li>
          <a class="discord-link" href={url(site.discord.path)}>Discord</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(21, 22, 28);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
    padding-block: var(--space-s);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .brand img {
    width: 40px;
    height: 40px;
    flex: none;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 550;
  }

  nav a:hover {
    color: var(--text);
  }

  /* The icon sits on the same line as the text links, so it is laid out as a box
     of its own rather than as a letter with space under it. */
  .icon-link {
    display: flex;
    align-items: center;
  }

  /* Without this a narrow phone squeezes the icon down to a dot to make room. */
  .icon-link svg {
    flex: none;
  }

  .discord-link {
    color: var(--bg) !important;
    background: var(--accent);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-weight: 650;
  }

  .discord-link:hover {
    background: #8df2b1;
  }

  @media (max-width: 30rem) {
    .brand-name {
      font-size: var(--step-0);
    }
    nav ul {
      gap: var(--space-s);
    }
  }

  /* The smallest phones. With the icon in the row the links no longer fit at the
     spacing above, and the page would scroll sideways. */
  @media (max-width: 22.5rem) {
    nav ul {
      gap: var(--space-xs);
    }
  }
</style>
