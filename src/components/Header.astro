---
import { Image } from 'astro:assets';
import logo from '../assets/socalmesh-logo.png';
import { site } from '../config/site';
import { url } from '../lib/url';

/* The header links. To add one: copy a line. `/#name` jumps to a section of the
   home page; `/name/` is a page of its own. */
const nav = [
  { label: 'Channels', href: url('/#channels') },
  { label: 'Maps', href: url('/#maps') },
  { label: 'Help', href: url('/help/') },
  { label: 'Links', href: url('/links/') },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={url('/')}>
      <Image
        class="logo-disc"
        src={logo}
        widths={[40, 80]}
        sizes="40px"
        format="webp"
        alt=""
        decoding="async"
      />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li>
          <a class="discord-link" href={site.discord.invite} rel="noopener">Discord</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(21, 22, 28);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    flex-wrap: wrap;
    padding-block: var(--space-s);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .brand img {
    width: 40px;
    height: 40px;
    flex: none;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 550;
  }

  nav a:hover {
    color: var(--text);
  }

  .discord-link {
    color: var(--bg) !important;
    background: var(--accent);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-weight: 650;
  }

  .discord-link:hover {
    background: #8df2b1;
  }

  @media (max-width: 30rem) {
    .brand-name {
      font-size: var(--step-0);
    }
    nav ul {
      gap: var(--space-s);
    }
  }
</style>
