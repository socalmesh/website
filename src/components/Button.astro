---
/** A link styled as a button. variant: "primary" (Discord), "accent", or "ghost". */
interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'ghost';
  external?: boolean;
  class?: string;
}

const { href, variant = 'accent', external = false, class: className = '' } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, className]}
  rel={external ? 'noopener' : undefined}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    font-weight: 650;
    font-size: var(--step-0);
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background-color 120ms ease,
      transform 120ms ease;
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn-primary {
    background: var(--accent);
    color: #0d1a12;
    box-shadow: 0 0 30px -8px var(--accent-glow);
    font-size: var(--step-1);
    padding: 1rem 2rem;
  }

  .btn-primary:hover {
    background: #8df2b1;
    color: #0d1a12;
  }

  .btn-accent {
    background: var(--accent);
    color: #0d1a12;
  }

  .btn-accent:hover {
    background: #8df2b1;
    color: #0d1a12;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text);
    border-color: var(--border-strong);
  }

  .btn-ghost:hover {
    background: var(--bg-raised);
    color: var(--text);
    border-color: var(--accent);
  }
</style>
