---
/** Readable column for markdown content (help articles). */
---

<div class="prose">
  <slot />
</div>

<style is:global>
  .prose {
    max-width: var(--width-prose);
  }

  .prose > * + * {
    margin-top: var(--space-m);
  }

  .prose h2 {
    font-size: var(--step-2);
    margin-top: var(--space-xl);
  }

  .prose h3 {
    font-size: var(--step-1);
    margin-top: var(--space-l);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.4rem;
  }

  .prose li + li {
    margin-top: var(--space-2xs);
  }

  .prose blockquote {
    border-left: 3px solid var(--accent-dim);
    padding: var(--space-xs) var(--space-m);
    background: var(--bg-raised);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--text-muted);
  }

  .prose blockquote > * + * {
    margin-top: var(--space-s);
  }

  /* Wide tables scroll sideways inside the article rather than pushing the page
     out. The table keeps `display: table`: giving it `display: block` makes a
     screen reader stop announcing it as a table at all. */
  .prose {
    overflow-x: auto;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    background: var(--bg-raised);
  }

  .prose strong {
    color: #f3f5fa;
  }
</style>
