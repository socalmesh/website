---
/**
 * The numbered "new here?" steps.
 *
 * The steps come from `startHere` in `src/config/site.ts`. Edit them there.
 * A step can carry an optional link: { label, url }.
 */
import { site } from '../config/site';
---

<ol class="steps">
  {
    site.startHere.map((step) => (
      <li>
        <h3>{step.title}</h3>
        <p>
          {step.body}
          {'link' in step && step.link && (
            <>
              {' '}
              <a href={step.link.url} rel="noopener">
                {step.link.label}
              </a>
            </>
          )}
        </p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    margin: 0;
    padding-top: var(--space-s);
    border-top: 2px solid var(--border);
  }

  .steps li::before {
    content: counter(step);
    display: block;
    margin-bottom: 0.35rem;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .steps h3 {
    margin: 0 0 0.35rem;
    font-size: var(--step-0);
  }

  .steps p {
    margin: 0;
    color: var(--text-muted);
  }
</style>
