---
/**
 * The channels the mesh runs on, side by side.
 *
 * The numbers come from `src/config/site.ts`. Edit them there, not here.
 * The one marked `recommended: true` gets the highlighted treatment and the
 * "Set this one" badge. One marked `experimental: true` gets a dimmed, dashed
 * card instead, so nobody mistakes something we are still testing for the
 * setting they should copy onto a new radio.
 */
import { site } from '../config/site';
---

<ul class="channels">
  {
    site.channels.map((channel) => (
      <li
        class:list={[
          'channel',
          { recommended: channel.recommended, experimental: channel.experimental },
        ]}
      >
        {channel.recommended && <span class="badge">Set this one</span>}
        {channel.experimental && <span class="badge badge-trial">Experimental</span>}
        <p class="short">{channel.short}</p>
        <p class="expanded">
          {channel.preset} · slot {channel.slot}
        </p>
        <p class="freq">{channel.frequency}</p>
        <p class="blurb">
          <strong>{channel.headline}</strong> {channel.blurb}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-m);
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
  }

  .channel {
    position: relative;
    margin: 0;
    padding: var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .channel.recommended {
    border-color: var(--accent);
    box-shadow: 0 0 30px -12px var(--accent-glow);
  }

  /* Deliberately quieter than the others: a dashed edge reads as "not settled yet". */
  .channel.experimental {
    border-style: dashed;
    border-color: var(--border-strong);
    background: transparent;
  }

  .experimental .short {
    color: var(--text-muted);
  }

  .badge {
    position: absolute;
    top: calc(-1 * var(--space-xs));
    left: var(--space-m);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: #0d0f14;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .short {
    margin: 0;
    font-size: clamp(2.75rem, 9vw, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .recommended .short {
    color: var(--accent);
  }

  /* Must come after .badge, which sets the accent background. */
  .badge-trial {
    background: var(--bg-raised);
    border: 1px dashed var(--border-strong);
    color: var(--text-muted);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
  }

  .expanded {
    margin: 0.35rem 0 0;
    font-size: var(--step-0);
    font-weight: 600;
  }

  .freq {
    margin: 0.1rem 0 var(--space-s);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .blurb {
    margin: 0;
    color: var(--text-muted);
  }

  .blurb strong {
    color: var(--text);
  }
</style>
