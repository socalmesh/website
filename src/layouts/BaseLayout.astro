---
/**
 * The page shell every page uses: <head>, header, footer.
 * Pages pass a title and a description; both are required so no page ships without them.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { url, absoluteUrl } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Optional share image path, relative to public/. Defaults to the site OG image. */
  ogImage?: string;
  /** Set on pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
}

const { title, description, ogImage = 'og-image.png', noindex = false } = Astro.props;

const fontFace = `@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${url('fonts/inter-latin-variable.woff2')}') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+2010-2027, U+20AC, U+2122, U+2190-2193, U+2212,
    U+2215, U+FEFF, U+FFFD;
}`;

const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageUrl = absoluteUrl(ogImage, Astro.site ?? site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- The one font file the site uses. Preloaded so text does not flash in a
         fallback face while the stylesheet is still being read. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={url('fonts/inter-latin-variable.woff2')}
      crossorigin
    />

    <!-- Declared here rather than in a .css file so the address goes through the
         same url() helper as the preload above — the site is served from a
         sub-folder today and from a domain root later, and these must agree or
         the font is downloaded twice. -->
    <style set:html={fontFace}></style>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={url('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
